# Local Auth + Firestore emulators. No cloud resources are created.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-sabobatage.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-sabobatage
VITE_FIREBASE_APP_ID=demo-sabobatage
VITE_USE_FIREBASE_EMULATORS=true
# Empty host uses the browser's hostname, so phones can connect over Wi-Fi.
VITE_FIREBASE_EMULATOR_HOST=
VITE_FIREBASE_AUTH_EMULATOR_PORT=9295
VITE_FIRESTORE_EMULATOR_PORT=8195
