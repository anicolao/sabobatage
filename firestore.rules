rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function room(id) { return /databases/$(database)/documents/games/$(id); }
  function event(id,sequence) { return /databases/$(database)/documents/games/$(id)/events/$(string(sequence)); }
  function validRoom(data) { return data.keys().hasOnly(['owner','players','revision']) && data.owner is string && data.players is list && data.players.size() <= 5 && data.revision is int && data.revision >= 1; }
  match /games/{gameId} {
   allow get: if signedIn();
   allow create: if signedIn() && gameId.matches('[A-Z2-9]{6}') && validRoom(request.resource.data)
    && request.resource.data.owner == request.auth.uid && request.resource.data.players == [] && request.resource.data.revision == 1
    && getAfter(event(gameId,1)).data.intent.type == 'game/created';
   allow update: if signedIn() && validRoom(request.resource.data)
    && request.resource.data.owner == resource.data.owner
    && request.resource.data.revision == resource.data.revision + 1
    && getAfter(event(gameId,request.resource.data.revision)).data.actorUid == request.auth.uid
    && ((getAfter(event(gameId,request.resource.data.revision)).data.intent.type == 'player/joined'
      && !(request.auth.uid in resource.data.players)
      && request.resource.data.players == resource.data.players.concat([request.auth.uid]))
     || (getAfter(event(gameId,request.resource.data.revision)).data.intent.type in ['game/command','action/undone']
      && (request.auth.uid == resource.data.owner || request.auth.uid in resource.data.players)
      && request.resource.data.players == resource.data.players));
   allow delete: if false;
   match /events/{eventId} {
    // Trusted clients replay the complete stream. Hands are private in presentation.
    allow read: if signedIn();
    allow create: if signedIn()
     && request.resource.data.keys().hasOnly(['id','actorUid','sequence','schemaVersion','reducerVersion','intent','createdAt'])
     && request.resource.data.id is string && request.resource.data.id.size() <= 64
     && request.resource.data.actorUid == request.auth.uid
     && request.resource.data.schemaVersion == 1 && request.resource.data.reducerVersion == 1
     && request.resource.data.createdAt == request.time
     && request.resource.data.sequence == getAfter(room(gameId)).data.revision
     && eventId == string(request.resource.data.sequence)
     && request.resource.data.intent is map
     && ((request.resource.data.intent.type == 'game/created' && !exists(room(gameId))
       && request.resource.data.sequence == 1 && request.resource.data.intent.seed is int
       && getAfter(room(gameId)).data.owner == request.auth.uid)
      || (exists(room(gameId)) && request.resource.data.sequence == get(room(gameId)).data.revision + 1
       && ((request.resource.data.intent.type == 'player/joined' && request.resource.data.intent.name is string
         && request.resource.data.intent.name.size() > 0 && request.resource.data.intent.name.size() <= 32
         && getAfter(room(gameId)).data.players == get(room(gameId)).data.players.concat([request.auth.uid]))
        || (request.resource.data.intent.type in ['game/command','action/undone']
         && (request.auth.uid == get(room(gameId)).data.owner || request.auth.uid in get(room(gameId)).data.players)))));
    allow update,delete: if false;
   }
  }
 }
}
